<dict>
    <key>Label</key>
    <string>com.barq.mac.sidecar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/saiprabhat/Project/BARQ-Mac/python/.venv/bin/python</string>
        <string>-m</string>
